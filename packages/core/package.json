{
  "name": "@murphychain/core",
  "version": "0.1.0",
  "description": "Core execution engine of the MurphyChain AI framework: AI class, provider abstraction, prompts, events, errors, and retry/timeout/cancellation controls.",
  "keywords": [
    "ai",
    "llm",
    "ai-framework",
    "typescript",
    "murphychain"
  ],
  "license": "MIT",
  "homepage": "https://github.com/murphtech/murphychain#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/murphtech/murphychain.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.18"
  }
}
