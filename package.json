{
  "name": "murphychain-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "clean": "pnpm -r exec rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "example:basic-chat": "tsx examples/basic-chat/index.ts",
    "example:streaming": "tsx examples/streaming/index.ts",
    "example:provider-switch": "tsx examples/provider-switch/index.ts",
    "example:custom-provider": "tsx examples/custom-provider/index.ts",
    "example:workflows": "tsx examples/workflows/index.ts",
    "example:agent": "tsx examples/agent/index.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "tsup": "^9.0.0",
    "vitest": "^5.0.5"
  }
}
